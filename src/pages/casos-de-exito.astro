---
import Layout from '../layouts/Layout.astro';

// Lista de casos de éxito con imagen, título y descripción
const successCases = [
  {
    subtitle: 'Caso de Éxito',
    title: 'Reducción de Costos Energéticos',
    description: `
      Implementamos un sistema fotovoltaico de última generación en una empresa manufacturera, logrando
      reducir sus costos de electricidad en un 40% y mejorando su eficiencia operativa.
    `,
    image: '/images/screens/casos-de-exito/caso1.jpeg',
  },
  {
    subtitle: 'Caso de Éxito',
    title: 'Energía Sustentable en el Sector Residencial',
    description: `
      Una familia logró independencia energética con nuestra solución de paneles solares, reduciendo su
      huella de carbono y asegurando energía limpia para el futuro.
    `,
    image: '/images/screens/casos-de-exito/caso2.jpeg',
  }
];

// Lista de videos (algunos están "próximamente")
const videos = [
  { title: 'VIDEO 1', url: 'https://www.youtube.com/embed/r7yLiOunSv4' },
  { title: 'VIDEO 2', url: '', comingSoon: true },
  { title: 'VIDEO 3', url: '', comingSoon: true }
];

const bgImage = '/images/screens/casos-de-exito/portada canal casos de exito.jpg';
---

<Layout title='Casos de Éxito'>

  <!-- Sección de introducción con fondo degradado -->
  <section 
    class="text-center pt-24 pb-16 px-6 bg-gradient-to-b from-neutral-800 to-gray-900 text-white flex flex-col items-center justify-center"
  >
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4">
      Casos de Éxito
    </h1>
    <p class="text-base sm:text-lg md:text-xl max-w-3xl text-gray-300">
      Descubre cómo nuestros clientes han logrado reducir costos y mejorar su eficiencia energética con nuestras soluciones innovadoras.
    </p>
  </section>

  <!-- Sección de videos responsiva -->
  <section class="py-10 px-4 sm:px-6 lg:px-20 bg-gray-100 dark:bg-gray-800">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {videos.map(video => (
        <div class="flex justify-center">
          <!-- Contenedor del video o mensaje de "Próximamente" -->
          <div class="w-full max-w-xs sm:max-w-sm md:max-w-md h-64 bg-white dark:bg-gray-900 border-4 border-gray-700 rounded-md shadow-lg flex justify-center items-center">
            {video.comingSoon ? (
              <span class="text-lg text-blue-500 font-bold">PRÓXIMAMENTE</span>
            ) : (
              <iframe
                width="100%"
                height="100%"
                src={`${video.url}?rel=0&modestbranding=1&controls=1&showinfo=0&iv_load_policy=3`}
                title={video.title}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="rounded-md"
              ></iframe>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
  <!-- Botón para consultar aviso de privacidad -->
<div class="flex justify-center py-20  bg-gradient-to-b from-neutral-800 to-gray-900">
  <a 
    href="/docs/Aviso%20de%20Privacidad_Mi%20energía.pdf"
    target="_blank" 
    rel="noopener noreferrer"
    class="border border-white text-white bg-transparent hover:bg-white hover:text-black font-semibold py-2 px-4 rounded transition-all duration-300"
>
  
    Consulta nuestro aviso de privacidad
  </a>
</div>


</Layout>
