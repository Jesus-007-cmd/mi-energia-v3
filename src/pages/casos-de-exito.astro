---

import Layout from '../layouts/Layout.astro';

// Definir casos de éxito
const successCases = [
  {
    subtitle: 'Caso de Éxito',
    title: 'Reducción de Costos Energéticos',
    description: `
      Implementamos un sistema fotovoltaico de última generación en una empresa manufacturera, logrando
      reducir sus costos de electricidad en un 40% y mejorando su eficiencia operativa.
    `,
    image: '/images/screens/casos-de-exito/caso1.jpeg',
  },
  {
    subtitle: 'Caso de Éxito',
    title: 'Energía Sustentable en el Sector Residencial',
    description: `
      Una familia logró independencia energética con nuestra solución de paneles solares, reduciendo su
      huella de carbono y asegurando energía limpia para el futuro.
    `,
    image: '/images/screens/casos-de-exito/caso2.jpeg',
  }
];
const videos = [
  { title: 'VIDEO 1', url: 'https://www.youtube.com/embed/r7yLiOunSv4' },
  { title: 'VIDEO 2', url: '', comingSoon: true },
  { title: 'VIDEO 3', url: '', comingSoon: true }
];
const bgImage = '/images/screens/casos-de-exito/portada canal casos de exito.jpg';
---

<Layout title='Casos de Éxito'>

  <!-- Título e introducción principal -->
  <section class="text-center py-16 px-6 bg-gradient-to-b from-neutral-800 to-gray-900 text-white flex flex-col items-center justify-center">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Casos de Éxito</h1>
    <p class="text-lg md:text-xl max-w-3xl text-gray-300">
      Descubre cómo nuestros clientes han logrado reducir costos y mejorar su eficiencia energética con nuestras soluciones innovadoras.
    </p>
  </section>
  <section class=" my-8">
    </section>
 
<section >

    <div class="flex justify-center py-10" >


      {videos.map(video => (
        <div class="w-full flex justify-center">
          <div class="w-80 h-64 bg-white border-4 border-gray-700 rounded-md shadow-lg flex justify-center items-center">
            {video.comingSoon ? (
              <span class="text-lg text-blue-500 font-bold">PRÓXIMAMENTE</span>
            ) : (
              <iframe
                width="100%"
                height="100%"
                src={`${video.url}?rel=0&modestbranding=1&controls=1&showinfo=0&iv_load_policy=3`}
                title={video.title}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="rounded-md"
              ></iframe>
            )}
          </div>
        </div>
      ))}
    </div>

  </section>

</Layout>
